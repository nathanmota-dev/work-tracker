{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "incremental": true,
    "tsBuildInfoFile": "../.cache/work-tracker/frontend/typescript/tsconfig.tsbuildinfo",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "benchmarks", "vitest.config.ts", "vitest.benchmark.config.ts", "vite.config.ts", "vite.pdf-assets.ts"]
}
