{
  "name": "work-tracker-app",
  "version": "1.0.0",
  "private": true,
  "description": "Work Tracker Desktop App",
  "homepage": "https://github.com/nathanmota-dev/work-tracker#readme",
  "bugs": {
    "url": "https://github.com/nathanmota-dev/work-tracker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathanmota-dev/work-tracker.git"
  },
  "license": "MIT",
  "author": "github.com/nathanmota-dev",
  "type": "commonjs",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build:cli && electron-vite dev --watch --noSandbox",
    "start": "electron-vite preview --skipBuild --noSandbox",
    "test": "npm run test:backend && npm run test --workspace web",
    "test:watch": "npm run test:watch --workspace web",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:frontend": "tsc --noEmit -p web/tsconfig.json",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "node scripts/ci/lint.cjs backend",
    "lint:frontend": "node scripts/ci/lint.cjs frontend",
    "build": "npm run typecheck && npm run build:cli && electron-vite build",
    "package": "npm run build && electron-builder --config desktop/electron-builder.yml",
    "postinstall": "install-electron",
    "build:cli": "node scripts/build-cli.mjs",
    "test:backend": "vitest run --config vitest.config.mts",
    "test:backend:watch": "vitest --config vitest.config.mts",
    "test:backend:coverage": "node scripts/ci/coverage.cjs backend",
    "test:frontend:coverage": "node scripts/ci/coverage.cjs frontend",
    "test:backend:integration": "npm run build:cli && vitest run --config vitest.integration.config.mts",
    "cli": "node out/cli/work-tracker.cjs",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs",
    "test:e2e:run": "node scripts/run-e2e.mjs",
    "test:e2e:debug": "npm run build && node scripts/run-e2e.mjs --debug",
    "test:e2e:report": "playwright show-report",
    "test:infra": "node --test scripts/*.test.cjs",
    "audit:ci": "node scripts/ci/audit.cjs",
    "quality:check": "node scripts/quality-gate.cjs",
    "quality:backend": "node scripts/quality-gate.cjs --layer backend",
    "quality:frontend": "node scripts/quality-gate.cjs --layer frontend",
    "benchmark": "npm run benchmark:backend && npm run benchmark:frontend",
    "benchmark:backend": "node scripts/ci/benchmark.cjs backend",
    "benchmark:frontend": "node scripts/ci/benchmark.cjs frontend",
    "performance:check": "node scripts/performance-compare.cjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "5.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jscpd": "^5.4.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "workspaces": [
    "web"
  ],
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.22.0"
  },
  "bin": {
    "work-tracker": "out/cli/work-tracker.cjs"
  }
}
